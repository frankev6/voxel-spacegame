  m_ActivationSlot: {fileID: 114350483966675068}
  m_BlockName: Custom HLSL
  m_HLSLCode: "void InitializeFx(inout VFXAttributes attributes, float3 eventPosition, float eventSize, float3 eventDirection, float3 eventVelocity, uint eventSeed, float4 eventColor, uint particleCount, int perEvent, float lifetimeScale, float lifetimeMax)\n{\n    uint local = attributes.spawnIndex % max(1, perEvent);\n    attributes.alive = local < particleCount;\n    uint r = eventSeed ^ (local * 747796405u + 2891336453u);\n    r = r * 1664525u + 1013904223u; float x = (r & 65535u) / 65535.0;\n    r = r * 1664525u + 1013904223u; float y = (r & 65535u) / 65535.0;\n    r = r * 1664525u + 1013904223u; float z = (r & 65535u) / 65535.0;\n    float3 spread = normalize(float3(x,y,z) * 2.0 - 1.0 + eventDirection * 0.8);\n    attributes.position = eventPosition;\n    attributes.velocity = eventVelocity;\n    attributes.lifetime = lifetimeScale * lifetimeMax;\n    attributes.size = eventSize * 0.95;\n    attributes.color = eventColor.rgb;\n    attributes.alpha = eventColor.a; attributes.angleX = x * 360; attributes.angleY = y * 360; attributes.angleZ = z * 360; attributes.angularVelocityX = (x * 2 - 1) * 360; attributes.angularVelocityY = (y * 2 - 1) * 360; attributes.angularVelocityZ = (z * 2 - 1) * 360;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitializeFx
    selectedIndex: 0
