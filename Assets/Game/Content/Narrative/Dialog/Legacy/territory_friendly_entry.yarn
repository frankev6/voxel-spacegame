        <<stop>>
<<endif>>
-> Request Local Contract #line:territory_friendly_entry_start_02 #quest
    <<start_quest contract_signal_relay>>
    <<stop>>
-> Continue Patrol #line:territory_friendly_entry_start_03 #leave
    <<stop>>
