  m_Name: quest_whisper_chain
  m_EditorClassIdentifier: Game.Data::Game.Data.Definitions.QuestDefinition
  id: quest_whisper_chain
  formerIds: []
  title: 'Story: Whisper Chain I'
  shortDescription: 'Travel to a nearby star and triangulate the anomalous signal.

    Destroy the interceptor that responded to your signal lock.

    Return to ARK and debrief Mission Control.'
  description: 'Mission Control has identified a repeating whisper-band signature. Move to a neighboring system and establish a stable lock.

    The lock drew a hostile interceptor into the system. Eliminate the hunter before it reports your position.

    With the interceptor down, bring the recovered telemetry back to ARK and submit a final debrief.'
  kind: 0
  autoTrack: 1
  stages:
  - id: triangulate
    title: 'Story: Whisper Chain I'
    objectives:
    - id: reach_signal_system
      text: 'Reach Signal System

        Enter a non-ARK system carrying the whisper signature.'
      doneWhen:
        source: since_accept("visited_starsys_whisper") >= 1
        sourceHash: 88560428085386776
        compilerVersion: 1
        hasErrors: 0
        root:
