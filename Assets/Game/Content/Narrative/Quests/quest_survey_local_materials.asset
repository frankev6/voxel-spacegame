  id: quest_survey_local_materials
  formerIds: []
  title: Survey Local Materials
  shortDescription: Collect 3 raw materials and return to ARK.
  description: NORA requested raw materials for emergency hull repairs. Gather at least three units of raw materials and deliver them at ARK station.
  kind: 1
  autoTrack: 1
  stages:
  - id: main
    title: Survey Local Materials
    objectives:
    - id: collect_raw_materials
      text: 'Collect Raw Materials

        Gather 3 units of raw materials.'
      doneWhen:
        source: has_item("resource_palladium", 3)
        sourceHash: 10988607801768678526
        compilerVersion: 1
        hasErrors: 0
        root:
          rid: 6548929065634496676
      progress:
        source: item_count("resource_palladium")
        sourceHash: 1589212930537717302
        compilerVersion: 1
        hasErrors: 0
        root:
          rid: 6548929065634496677
      target: 3
      latch: 0
      optional: 0
      marker:
        starSystem: {fileID: 11400000, guid: a93d1205a81b5ca3be814bc3473818ac, type: 2}
        bodyTag: ark_station
        label: Return to ARK
    - id: deliver_to_ark
      text: 'Deliver Materials

        Turn in the materials at ARK station.'
      doneWhen:
        source: ($story_survey_complete) or $survey_local_materials_deliver_to_ark
