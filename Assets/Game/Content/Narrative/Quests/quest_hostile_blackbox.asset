  id: quest_hostile_blackbox
  formerIds: []
  title: Hostile Telemetry Blackbox
  shortDescription: Survive one hostile contact and return telemetry to ARK.
  description: Border scouts tagged hostile signatures. Survive one engagement, recover telemetry, and submit the blackbox package at ARK.
  kind: 1
  autoTrack: 1
  stages:
