<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement class="list__item ship-log-row" picking-mode="Ignore">
    <ui:VisualElement class="ship-log-row-copy" picking-mode="Ignore">
      <ui:Label name="row-subtitle" class="text-xs text-muted text-ellipsis" picking-mode="Ignore" />
      <ui:Label name="row-title" class="text-m text-ellipsis" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Label name="row-state" text="New" class="text-xs ship-log-new" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
