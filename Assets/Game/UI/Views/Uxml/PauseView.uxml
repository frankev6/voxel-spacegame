<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:controls="Game.UI.Controls">
    <Style src="../../Theme/screens/pause.uss" />
    <ui:VisualElement class="modal" picking-mode="Position">
        <ui:VisualElement class="modal__scrim" />
        <ui:VisualElement name="pause-panel" class="modal__window panel panel--modal pause-window">
            <ui:Label text="Paused" class="modal__title text-display text-xl" />
            <ui:ScrollView name="pause-actions-scroll" class="pause-actions-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
              <ui:VisualElement class="pause-actions stack-m" picking-mode="Ignore">
            <ui:Button name="pause-resume" text="Resume" class="btn btn--primary" />
            <ui:Button name="pause-save" text="Save" class="btn btn--secondary" />
            <ui:Label name="pause-save-blocked" class="text-muted text-xs">
                <Bindings><ui:DataBinding property="text" data-source-path="SaveBlockedReason" binding-mode="ToTarget" /></Bindings>
            </ui:Label>
            <ui:Button name="pause-load" text="Load" class="btn btn--secondary" />
            <ui:Button name="pause-settings" text="Settings" class="btn btn--secondary" />
            <ui:Button name="pause-main-menu" text="Main menu" class="btn btn--secondary" />
            <ui:Button name="pause-quit" text="Quit" class="btn btn--ghost" />
              </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement name="pause-key-hints" class="pause-key-hints" picking-mode="Ignore">
                <ui:VisualElement class="pause-hint-row" picking-mode="Ignore">
                    <controls:KeyHint name="pause-back-key" action-path="Global/Back" picking-mode="Ignore" />
                    <ui:Label text="Resume" class="text-s text-muted" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="pause-hint-row" picking-mode="Ignore">
                    <controls:KeyHint name="pause-console-key" action-path="Global/DevConsole" picking-mode="Ignore" />
                    <ui:Label text="Console" class="text-s text-muted" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
