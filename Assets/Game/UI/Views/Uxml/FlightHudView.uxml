<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:controls="Game.UI.Controls">
    <Style src="../../Theme/screens/hud.uss" />
    <ui:VisualElement class="flight-hud" picking-mode="Ignore">
        <ui:VisualElement name="hud-region-title" class="hud-region anchor-top-center hud-title" picking-mode="Ignore">
            <ui:Label name="hud-title" class="text-display hud-title__name" picking-mode="Ignore" />
            <ui:Label name="hud-title-detail" class="text-s hud-title__detail" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hud-region-objective" class="hud-region anchor-top-center hud-objective" picking-mode="Ignore">
            <ui:Label name="hud-objective-title" class="text-s hud-objective__title" picking-mode="Ignore"><Bindings><ui:DataBinding property="text" data-source-path="ObjectiveTitle" binding-mode="ToTarget" /></Bindings></ui:Label>
            <ui:Label name="hud-objective-text" class="text-s text-ellipsis hud-objective__text" picking-mode="Ignore"><Bindings><ui:DataBinding property="text" data-source-path="ObjectiveText" binding-mode="ToTarget" /></Bindings></ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="hud-readouts" class="hud-readouts" picking-mode="Ignore">
            <ui:VisualElement name="hud-readout-hull" class="hud-readout hud-readout--hull" picking-mode="Ignore"><ui:Label text="HULL" class="hud-readout__caption" picking-mode="Ignore" /><ui:Label name="hud-hull-value" class="hud-readout__value" picking-mode="Ignore" /><ui:Label text="%" class="hud-readout__unit" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hud-readout-shield" class="hud-readout hud-readout--shield" picking-mode="Ignore"><ui:Label text="SHIELD" class="hud-readout__caption" picking-mode="Ignore" /><ui:Label name="hud-shield-value" class="hud-readout__value" picking-mode="Ignore" /><ui:Label text="%" class="hud-readout__unit" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hud-readout-energy" class="hud-readout hud-readout--energy" picking-mode="Ignore"><ui:Label text="ENERGY" class="hud-readout__caption" picking-mode="Ignore" /><ui:Label name="hud-energy-value" class="hud-readout__value" picking-mode="Ignore" /><ui:Label text="%" class="hud-readout__unit" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hud-readout-speed" class="hud-readout hud-readout--speed" picking-mode="Ignore"><ui:Label name="hud-speed" class="hud-readout__value" picking-mode="Ignore" /><ui:Label name="hud-speed-unit" text="m/s" class="hud-readout__unit" picking-mode="Ignore" /><ui:Label name="hud-cruise" class="hud-readout__caption hud-cruise" picking-mode="Ignore" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hud-region-abilities" class="hud-region anchor-bottom-center hud-abilities" picking-mode="Ignore">
            <ui:VisualElement name="hud-ability-row" class="hud-slot-row" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
