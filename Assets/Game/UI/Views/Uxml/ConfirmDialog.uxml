<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="modal" picking-mode="Position">
        <ui:VisualElement name="confirm-scrim" class="modal__scrim" picking-mode="Position" />
        <ui:VisualElement name="confirm-window" class="modal__window panel panel--modal dialog-services-window" picking-mode="Position">
            <ui:Label name="confirm-title" class="modal__title text-display" picking-mode="Ignore">
                <Bindings><ui:DataBinding property="text" data-source-path="Title" binding-mode="ToTarget" /></Bindings>
            </ui:Label>
            <ui:ScrollView name="confirm-scroll" class="modal__body" picking-mode="Ignore">
                <ui:Label name="confirm-body" picking-mode="Ignore">
                    <Bindings><ui:DataBinding property="text" data-source-path="Body" binding-mode="ToTarget" /></Bindings>
                </ui:Label>
            </ui:ScrollView>
            <ui:VisualElement name="confirm-actions" class="modal__actions" picking-mode="Ignore">
                <ui:Button name="confirm-option-0" class="btn">
                    <Bindings><ui:DataBinding property="text" data-source-path="Label" binding-mode="ToTarget" /></Bindings>
                </ui:Button>
                <ui:Button name="confirm-option-1" class="btn">
                    <Bindings><ui:DataBinding property="text" data-source-path="Label" binding-mode="ToTarget" /></Bindings>
                </ui:Button>
                <ui:Button name="confirm-option-2" class="btn">
                    <Bindings><ui:DataBinding property="text" data-source-path="Label" binding-mode="ToTarget" /></Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
