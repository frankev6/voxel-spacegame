<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:game="Game.UI.Controls">
    <Style src="../../Theme/screens/maps.uss" />
    <ui:VisualElement class="maps-screen" picking-mode="Ignore">
        <ui:VisualElement name="galaxy-map-panel" class="panel maps-panel">
            <ui:VisualElement class="panel__header" picking-mode="Ignore">
                <ui:Label text="Galaxy map" class="panel__title text-display" picking-mode="Ignore" />
                <ui:VisualElement class="panel__header-actions"><ui:Button name="galaxy-map-close" text="Close" class="btn btn--ghost" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel__body maps-body" picking-mode="Ignore">
                <game:MapCanvas name="galaxy-map-canvas" class="grow" />
                <ui:ScrollView name="galaxy-map-details" class="maps-details" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:Label name="galaxy-map-selected-name" class="text-display text-l maps-description" picking-mode="Ignore" />
                    <ui:Label name="galaxy-map-selected-info" class="text-s maps-description" picking-mode="Ignore" />
                    <ui:Button name="galaxy-map-set-destination" text="Set destination" class="btn btn--primary" /><ui:Label name="galaxy-map-destination-blocked" class="text-s text-muted maps-description" picking-mode="Ignore" /><ui:Button name="galaxy-map-clear-destination" text="Clear destination" class="btn btn--secondary" />
                    <ui:Button name="galaxy-map-focus-current" text="Focus current system" class="btn btn--secondary" />
                    <ui:VisualElement class="maps-zoom"><ui:Button name="galaxy-map-zoom-in" text="Zoom +" class="btn btn--ghost" /><ui:Button name="galaxy-map-zoom-out" text="Zoom −" class="btn btn--ghost" /></ui:VisualElement>
                    <ui:Label text="Drag to pan · Scroll to zoom
Arrow keys to pan · + / − to zoom · Home to focus" class="text-s text-muted maps-description" picking-mode="Ignore" />
                    <ui:Label text="◆ Player   ◇ Destination
? Rumor   + Objective
Dashed lane: gated" class="text-s text-muted maps-description" picking-mode="Ignore" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
