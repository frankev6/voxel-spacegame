/* SPEC-60 §4.6. Shared typography and layout helpers. */
.text-xs { font-size: var(--text-xs); }
.text-s { font-size: var(--text-s); }
.text-m { font-size: var(--text-m); }
.text-l { font-size: var(--text-l); }
.text-xl { font-size: var(--text-xl); }
.text-xxl { font-size: var(--text-xxl); }
.text-muted { color: var(--color-text-muted); }
.text-mono { -unity-font-definition: var(--font-mono); }
.text-display { -unity-font-definition: var(--font-display); }
.text-ellipsis {
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}
.row { flex-direction: row; }
.col { flex-direction: column; }
.grow, .spacer { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.stack-s > * { margin-bottom: var(--space-2); }
.stack-m > * { margin-bottom: var(--space-3); }
.stack-l > * { margin-bottom: var(--space-4); }
