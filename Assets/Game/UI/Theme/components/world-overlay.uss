/* QA-001: in-world tags for ships, stations and wrecks (WorldOverlaySystem). Subtle by default, stronger when targeted. */
.world-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.world-tag { position: absolute; opacity: 0.7; }
.world-tag__corner { position: absolute; width: 8px; height: 8px; border-color: var(--color-neutral); }
.world-tag__corner--tl { left: 0; top: 0; border-left-width: var(--border-thin); border-top-width: var(--border-thin); }
.world-tag__corner--tr { right: 0; top: 0; border-right-width: var(--border-thin); border-top-width: var(--border-thin); }
.world-tag__corner--bl { left: 0; bottom: 0; border-left-width: var(--border-thin); border-bottom-width: var(--border-thin); }
.world-tag__corner--br { right: 0; bottom: 0; border-right-width: var(--border-thin); border-bottom-width: var(--border-thin); }
.world-tag__label { position: absolute; left: 0; top: 100%; margin-top: var(--space-1); padding: 0; font-size: var(--text-xs); color: var(--color-text); white-space: nowrap; }
.world-tag__detail { color: var(--color-text-muted); }
.world-tag--ally .world-tag__corner { border-color: var(--color-ally); }
.world-tag--enemy .world-tag__corner { border-color: var(--color-enemy); }
.world-tag--enemy .world-tag__label { color: var(--color-enemy); }
.world-tag--salvage .world-tag__corner { border-color: var(--color-positive); }
.world-tag--salvage .world-tag__label { color: var(--color-positive); }
.world-tag--active { opacity: 1; }
.world-tag--active .world-tag__corner { width: 14px; height: 14px; border-left-width: var(--border-thick); border-right-width: var(--border-thick); border-top-width: var(--border-thick); border-bottom-width: var(--border-thick); }
.world-tag--active .world-tag__corner--tl { border-right-width: 0; border-bottom-width: 0; }
.world-tag--active .world-tag__corner--tr { border-left-width: 0; border-bottom-width: 0; }
.world-tag--active .world-tag__corner--bl { border-right-width: 0; border-top-width: 0; }
.world-tag--active .world-tag__corner--br { border-left-width: 0; border-top-width: 0; }
/* QA-001 hit confirmation: a small cross at each of the player's hits, popped and faded by HitMarkerSystem. */
.hit-marker { position: absolute; translate: -50% -50%; font-size: var(--text-m); -unity-font-style: bold; color: var(--color-text); padding: 0; margin: 0; }
.hit-marker--energy { color: var(--color-shield); }
/* HUD redesign (2026-10-21): the canvas draws the ping ring, the target arcs and the edge chevrons; tags appear only on what matters. */
.world-overlay__canvas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.world-tag__label { text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
.world-tag__detail { margin-top: 20px; }
.world-tag__detail.is-warning { color: var(--color-objective); }
.world-tag--pinged { opacity: 0.55; }
.world-tag--interaction .world-tag__corner { border-color: var(--color-accent); }
.world-tag--interaction .world-tag__label { color: var(--color-accent-strong); -unity-font-style: bold; }
.world-tag--dim { opacity: 0.45; }
.world-edge { position: absolute; translate: -50% -50%; font-size: var(--text-xs); padding: 0; margin: 0; white-space: nowrap; -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
