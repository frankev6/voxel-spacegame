/* QA-001 NOCTURNE UI skin (DESIGN-GUIDE §8): translucent dark panels, 1 px lines, corner brackets on plates, thin
   glowing bars, display type with a faint cyan glow. Imported last so it refines every component without changing
   any layout size (the layout tests pin region geometry). Brackets are added by UI/Controls/CornerBrackets. */

/* Panels and HUD plates: the crew's instrument glass over a dirty world. */
.hud-plate {
    background-color: var(--color-glass);
    border-color: var(--color-line);
}
.panel {
    background-color: var(--color-glass-strong);
    border-color: var(--color-line);
}
.panel--modal { border-color: var(--color-line-accent-soft); }
.panel__header { border-bottom-color: var(--color-line-soft); }
.panel__footer { border-top-color: var(--color-line-soft); }
.panel__title, .text-display {
    color: var(--color-accent);
    letter-spacing: 2px;
    /* No text-shadow: its blur samples outside the placeholder SDF atlas padding and draws stray dashes. */
}

/* Corner brackets (CornerBrackets.Decorate): short L marks just inside each corner. */
.corner-bracket { position: absolute; width: 9px; height: 9px; border-color: var(--color-line-accent); }
.corner-bracket--tl { left: 0; top: 0; border-left-width: 1px; border-top-width: 1px; }
.corner-bracket--tr { right: 0; top: 0; border-right-width: 1px; border-top-width: 1px; }
.corner-bracket--bl { left: 0; bottom: 0; border-left-width: 1px; border-bottom-width: 1px; }
.corner-bracket--br { right: 0; bottom: 0; border-right-width: 1px; border-bottom-width: 1px; }

/* Meters: a hairline track with a 2 px glowing fill; small spaced captions, mono values. */
.meter { background-color: var(--color-transparent); padding-left: 0; padding-right: 0; }
.meter__fill { height: 2px; bottom: 3px; }
.meter__track { position: absolute; left: 0; right: 0; bottom: 3px; height: 1px; background-color: var(--color-line-soft); }
.meter__caption { letter-spacing: 2px; color: var(--color-text-muted); font-size: var(--text-xs); }
.meter--low .meter__caption { color: var(--color-danger); }
.meter--absent { opacity: 0.45; }

/* Slots: dark cards with a lit key and a thin cooldown line. */
.slot { background-color: var(--color-glass-card); border-color: var(--color-line); }
.slot__key, .slot__count { background-color: var(--color-transparent); }
.slot__key { color: var(--color-accent); }
.slot.is-ready { background-color: var(--color-glass-card-active); }
.slot:hover, .slot:focus { border-color: var(--color-line-accent); }

/* Radar: ringed scope with a faint crosshair. */
.hud-radar { background-color: var(--color-glass-scope); border-color: var(--color-line-accent-soft); }
.hud-radar-ring { position: absolute; border-width: 1px; border-color: var(--color-line-faint); border-radius: 50%; }
.hud-radar-ring--inner { left: 33%; top: 33%; right: 33%; bottom: 33%; }
.hud-radar-ring--mid { left: 16.5%; top: 16.5%; right: 16.5%; bottom: 16.5%; }
.hud-radar-axis { position: absolute; background-color: var(--color-line-faint); }
.hud-radar-axis--h { left: 0; right: 0; top: 50%; height: 1px; }
.hud-radar-axis--v { top: 0; bottom: 0; left: 50%; width: 1px; }

/* Buttons: hairline frames that light up rather than filled blocks. */
.btn { border-color: var(--color-line); }
.btn:hover { border-color: var(--color-line-accent); }

/* Toasts and tooltips share the glass. */
.toast { background-color: var(--color-glass-card); border-color: var(--color-line); }
.tooltip { background-color: var(--color-glass-strong); border-color: var(--color-line-accent-soft); }
