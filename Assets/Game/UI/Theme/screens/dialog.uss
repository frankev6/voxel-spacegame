/* SPEC-41 DLG-009: approved NOCTURNE tokens; proportionate layout at both reference sizes. */
.dialog-screen { flex-grow: 1; align-items: center; justify-content: center; }
.dialog-panel { align-self: center; width: 80%; max-width: 90%; height: 90%; }
.dialog-body { min-height: 0; flex-shrink: 1; flex-basis: 0; }
.dialog-illustration { height: 20%; flex-shrink: 0; margin-bottom: var(--space-3); }
.dialog-page { flex-grow: 2; flex-basis: 0; min-height: 0; margin-bottom: var(--space-3); }
.dialog-portrait { width: var(--space-8); height: var(--space-8); flex-shrink: 0; margin-right: var(--space-3); }
.dialog-lines { min-width: 0; min-height: 0; flex-shrink: 1; }
.dialog-options { flex-grow: 1; flex-basis: 0; min-height: 0; flex-shrink: 1; }
.dialog-line-row { padding: var(--space-2) var(--space-3); }
.dialog-line-speaker { color: var(--color-accent); margin-bottom: var(--space-1); white-space: normal; }
.dialog-line-text { white-space: normal; }
.dialog-line-container { opacity: 1; transition-property: opacity; transition-duration: var(--duration-normal); }
.dialog__line--enter { opacity: 0; }
.dialog__line--draft .dialog-line-text { color: var(--color-warning); }
.dialog-option { flex-direction: row; align-items: center; min-height: var(--space-7); }
.dialog-option-number { width: var(--space-5); flex-shrink: 0; color: var(--color-accent); -unity-text-align: middle-left; }
.dialog-option-text { flex-grow: 1; min-width: 0; white-space: normal; -unity-text-align: middle-left; }
.dialog__option--quest { border-color: var(--color-objective); }
.dialog-option.is-disabled .dialog-option-text, .dialog-option.is-disabled .dialog-option-number { color: var(--color-text-muted); }
.dialog-hint { white-space: normal; }
.reduce-motion .dialog-line-container { transition-duration: 0s; }
