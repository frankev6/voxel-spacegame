/* SPEC-61 HUD-018: geometry owns the four plates; SPEC-51 owns their panel contents.
   QA-001 creative layout: slim toolbar, hotbar + paint strip bottom-centre, catalogue drawer left, compact stats right. */
.ship-editor-host { flex-grow: 1; min-width: 0; min-height: 0; }
.ship-editor-region { padding: 0; }
.ship-editor-top { top: 0; left: 0; right: 0; height: 40px; }
.ship-editor-bottom { bottom: var(--space-3); left: 50%; translate: -50% 0; width: 820px; max-width: 98%; height: 112px; }
.ship-editor-left { top: 48px; bottom: 132px; left: var(--space-3); width: 360px; }
.ship-editor-right { top: 48px; right: var(--space-3); width: 320px; height: 360px; }
.ship-editor-right.editor-details--open { height: auto; bottom: 132px; }
.ship-editor-top .editor-toolbar-row { height: 30px; }
