/* SPEC-61 HUD-004: screen dimensions here; all appearance from approved NOCTURNE tokens. */
.save-slots-screen { flex-grow: 1; align-items: center; justify-content: center; }
.save-slots-panel { width: 880px; max-width: 90%; height: 720px; max-height: 90%; }
.save-slots-body { min-height: 0; flex-shrink: 1; flex-basis: 0; }
.save-slots-list { min-height: 0; flex-shrink: 1; }
.save-slot-row { height: 88px; flex-direction: column; justify-content: center; align-items: stretch; }
.save-slot-title { flex-grow: 1; min-width: 0; -unity-font-definition: var(--font-body-strong); }
.save-slot-tag { margin-left: var(--space-4); }
.save-slots-actions > .btn { margin-left: var(--space-2); }
.save-slots-actions > .btn:first-child { margin-left: 0; }
