/* SPEC-61 HUD-014: bounded tab panes; story prose scrolls independently of selection lists. */
.ship-log-screen { flex-grow: 1; align-items: center; justify-content: center; }
.ship-log-panel { width: 1600px; max-width: 92%; height: 920px; max-height: 90%; }
.ship-log-tabs { flex-shrink: 0; margin: var(--space-2) var(--space-4); }
.ship-log-body, .ship-log-tab { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; }
.ship-log-columns { flex-direction: row; }
.ship-log-sidebar { width: 36%; max-width: 420px; flex-shrink: 0; min-height: 0; }
.ship-log-detail { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; margin-left: var(--space-4); }
.ship-log-fill { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; }
.ship-log-prose-scroll { flex-grow: 2; flex-basis: 0; min-height: 0; }
.ship-log-prose, .ship-log-objective { white-space: normal; min-width: 0; flex-shrink: 0; }
.ship-log-objective { margin-top: var(--space-2); }
.ship-log-objective.is-done { opacity: 0.65; }
.ship-log-section { flex-shrink: 0; margin-top: var(--space-2); }
.ship-log-filter { flex-shrink: 0; margin-bottom: var(--space-2); }
.ship-log-row.list__item { height: 88px; flex-direction: row; align-items: center; padding: var(--space-2); }
.ship-log-row-copy { flex-grow: 1; flex-basis: 0; min-width: 0; }
.ship-log-track { width: 128px; flex-shrink: 0; margin-left: var(--space-2); }
.ship-log-map { width: 164px; flex-shrink: 0; margin-left: var(--space-3); }
.ship-log-new { flex-shrink: 0; margin-left: var(--space-2); }
.ship-log-mystery-row.list__item, .ship-log-journal-row.list__item, .ship-log-log-row.list__item { height: auto; min-height: 40px; flex-direction: column; align-items: stretch; padding: var(--space-2); }
