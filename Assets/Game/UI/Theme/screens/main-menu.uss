/* SPEC-61: screen regions own dimensions; appearance uses the approved theme. */
/* QA-001: the menu floats over the NOCTURNE showcase scene; only the column keeps a glass backing. */
.main-menu-screen { justify-content: center; background-color: var(--color-transparent); }
.main-menu-column { background-color: var(--color-glass); padding: var(--space-5); border-left-width: 1px; border-left-color: var(--color-line-accent-soft); }
.main-menu-column { width: 420px; max-width: 90%; margin-left: var(--space-8); }
.main-menu-subtitle { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.main-menu-version { position: absolute; right: var(--space-8); bottom: var(--space-8); }
/* DESIGN-GUIDE §8: display type is wide, uppercase and letter-spaced (the Michroma face is pending; spacing carries it). */
#main-menu-title { letter-spacing: 9px; margin-bottom: var(--space-4); }
