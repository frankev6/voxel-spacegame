/* SPEC-51 EDT-021: bounded panels and pooled rows, NOCTURNE tokens only. */
.editor-pane { flex-grow: 1; min-height: 0; min-width: 0; padding: var(--space-2); }
.editor-heading { flex-shrink: 0; margin: var(--space-1); }
.editor-toolbar { flex-grow: 1; min-height: 0; }
.editor-toolbar-row { flex-direction: row; align-items: center; height: 26px; flex-shrink: 0; }
.editor-tool { flex-shrink: 0; white-space: nowrap; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; min-height: 24px; }
.editor-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.editor-stats { flex-grow: 3; }
.editor-bom { flex-grow: 2; }
.editor-issues { flex-grow: 1; }
.editor-palette-grid .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.editor-colors { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.editor-swatch { width: 30px; height: 28px; margin: var(--space-1); padding: 0; border-color: var(--color-border); border-width: var(--border-thin); }
.editor-swatch.is-selected { border-color: var(--color-accent); border-width: var(--border-thick); }
.editor-stat-row { flex-direction: row; min-height: 28px; align-items: center; }
.editor-stat-label { flex-grow: 1; min-width: 0; }
.editor-stat-value, .editor-stat-delta { width: 90px; flex-shrink: 0; -unity-text-align: middle-right; }
.editor-delta--better { color: var(--color-positive); }
.editor-delta--worse, .editor-shortfall, .editor-error { color: var(--color-danger); }
.editor-warning { color: var(--color-warning); }
.editor-bom-row { min-height: 48px; }
.editor-bom-counts { flex-direction: row; }
.editor-bom-count { flex-grow: 1; flex-basis: 0; }
.editor-summary { flex-shrink: 0; min-height: 24px; margin: var(--space-1); }
.editor-actions, .editor-pager { flex-direction: row; align-items: center; flex-shrink: 0; }
.editor-actions > .btn { flex-grow: 1; min-width: 0; padding: var(--space-1); }
.editor-page-label { flex-grow: 1; -unity-text-align: middle-center; }
.editor-footer { flex-direction: row; flex-grow: 1; min-width: 0; align-items: center; padding: var(--space-2); }
.editor-footer-label { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: var(--space-2); }
.editor-key-hints { flex-direction: row; flex-shrink: 0; }

.editor-fragment { flex-grow: 1; min-height: 0; min-width: 0; }
.editor-key-hints > .key-hint { font-size: var(--text-xs); padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; }
/* QA-001 creative hotbar and paint strip. */
.editor-bottom--creative { flex-direction: column; }
.editor-hotbar { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; padding: var(--space-1); }
.editor-hotbar > .slot { width: 56px; height: 56px; margin: 2px; }
.editor-colors--compact { flex-direction: row; flex-wrap: wrap; width: 196px; margin-left: var(--space-3); flex-shrink: 0; }
.editor-colors--compact > .editor-swatch { width: 20px; height: 20px; margin: 2px; }
.editor-bottom--creative .editor-footer { flex-grow: 0; height: 30px; padding-top: 0; padding-bottom: 0; }
.ship-editor-right .editor-stat-value { width: 70px; }
.ship-editor-right .editor-stat-delta { width: 56px; }
.ship-editor-right .editor-actions { flex-wrap: wrap; }
