# Line endings
* text=auto
*.cs text eol=lf diff=csharp
*.uss text eol=lf
*.uxml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf

# Unity YAML: merge as text
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.vfx text eol=lf

# Binary assets. Git LFS is NOT enabled yet (ADR-0008): before the first push to GitHub run
#   git lfs install && git lfs migrate import --everything --include="<patterns below>"
# and then uncomment the filter=lfs lines.
*.png binary
*.jpg binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.otf binary
*.ttf binary
*.fbx binary
*.obj binary
