<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/LootPickerStyles.uss?fileID=7433441132597879392&amp;guid=f9c4050d22488224ea05889ed25b7ae3&amp;type=3#LootPickerStyles"/>
    <Style src="project://database/Assets/Game/UI/styles.uss?fileID=7433441132597879392&amp;guid=61d281347f6da7842b51b1b08eb220ef&amp;type=3#styles"/>
    <engine:VisualElement class="intel-theme-panel" style="flex-grow: 1;">
        <engine:VisualElement name="topContainer" style="flex-grow: 1; align-self: auto; align-items: center; align-content: flex-start; justify-content: center; height: 10%; flex-direction: column;">
            <engine:Label text="Trade" name="Label" style="color: rgb(255, 255, 255); font-size: 49px; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Regular&quot;); -unity-font-style: bold;"/>
            <engine:VisualElement name="filter-bar" style="flex-direction: row; margin-top: 10px; justify-content: center;"/>
        </engine:VisualElement>
        <engine:VisualElement name="centerContainer" style="height: 80%; width: 100%; padding-right: 26px; padding-left: 26px; flex-grow: 1; overflow: hidden; padding-top: 26px; padding-bottom: 26px; align-self: center;">
            <engine:ScrollView class="holo-scrollview" horizontal-scroller-visibility="Hidden">
                <engine:VisualElement name="scrollcontainer" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; justify-content: flex-start;">
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
