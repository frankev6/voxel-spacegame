                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                    <engine:VisualElement name="loot" class="loot-item"/>
                </engine:VisualElement>
            </engine:ScrollView>
        </engine:VisualElement>
        <engine:VisualElement name="bottomContainer" style="flex-grow: 1; align-self: auto; align-items: center; align-content: flex-start; justify-content: center; height: 10%; flex-direction: row;">
            <engine:Button text="Leave" name="continueBtn" class="button" style="font-size: 20px;"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
