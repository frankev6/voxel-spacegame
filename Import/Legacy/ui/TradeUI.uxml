<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/styles.uss?fileID=7433441132597879392&amp;guid=61d281347f6da7842b51b1b08eb220ef&amp;type=3#styles" />
    <Style src="project://database/Assets/Game/UI/StorageStyles.uss?fileID=7433441132597879392&amp;guid=a6b9056e0107d4947a4655de4cd1e46c&amp;type=3#StorageStyles" />
    <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: row; background-color: rgb(31, 26, 26); background-image: url(&quot;project://database/Assets/RPGUI/Textures/Demo/Background2.png?fileID=2800000&amp;guid=927e0d0f7d8f7e44a82968d25565703d&amp;type=3#Background2&quot;);">
        <ui:VisualElement name="InfoPanel" style="flex-grow: 1; width: 20%; justify-content: center; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:Label text="Label" name="InfoLabel" style="color: rgb(255, 255, 255);" />
            <ui:Button text="Execute Trade" name="ExecuteTradeButton" class="button" />
            <ui:Button text="Reset" name="ResetButton" class="button" />
        </ui:VisualElement>
        <ui:VisualElement name="InventoryPanel" style="flex-grow: 1; width: 80%; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:VisualElement name="MerchantInventoryContainer" class="container" />
            <ui:VisualElement name="PlayerInventoryContainer" class="container" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
