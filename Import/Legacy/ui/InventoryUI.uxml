<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/styles.uss?fileID=7433441132597879392&amp;guid=61d281347f6da7842b51b1b08eb220ef&amp;type=3#styles"/>
    <Style src="project://database/Assets/Game/UI/Inventory.uss?fileID=7433441132597879392&amp;guid=c9bc0feb4198573448ac64c40fdee660&amp;type=3#Inventory"/>
    <ui:VisualElement class="container_bottom" style="flex-grow: 1; padding: 20px; flex-direction: column;">
        <ui:VisualElement name="Controls" style="flex-direction: row; justify-content: center; margin-bottom: 10px; width: 100%;">
            <ui:Button name="SortButton" text="Sort" style="width: 80px; height: 30px; margin-right: 10px;"/>
            <ui:Button name="StackButton" text="Stack All" style="width: 100px; height: 30px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" class="inventory" style="flex-grow: 1; padding: 20px; height: auto; background-image: url(&quot;project://database/Assets/scifi_ui%20white/PNG/Full%20screen%20border/Blue/1x/Asset%201.png?fileID=2800000&amp;guid=f0042641341f3284891f9bdf52a7b975&amp;type=3#Asset 1&quot;);">
            <ui:Label text="Toolbar" style="color: rgb(136, 136, 136); font-size: 12px; margin-bottom: 5px;"/>
            <ui:VisualElement name="ToolbarContainer" style="background-color: rgba(0, 0, 0, 0.2); border-radius: 5px; padding: 10px; margin-bottom: 20px;">
                <ui:VisualElement name="ToolbarSlots" class="slotsContainer" style="flex-direction: row; flex-wrap: wrap;"/>
            </ui:VisualElement>
            <ui:Label text="Inventory" style="color: rgb(136, 136, 136); font-size: 12px; margin-bottom: 5px;"/>
            <ui:ScrollView name="MainInventoryScroll" style="flex-grow: 1;">
                <ui:VisualElement name="MainSlots" class="slotsContainer" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
