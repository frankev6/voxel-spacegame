<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/styles.uss?fileID=7433441132597879392&amp;guid=61d281347f6da7842b51b1b08eb220ef&amp;type=3#styles"/>
    <Style src="project://database/Assets/Game/UI/PauseView.uss?fileID=7433441132597879392&amp;guid=8e43fd0dcac5458f9b63eb7f7eeb03ee&amp;type=3#PauseView"/>
    <ui:VisualElement enabled="true" class="intel-theme-screen" style="flex-grow: 1; justify-content: center; align-items: flex-start; opacity: 1;">
        <ui:VisualElement name="bg_dark" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.51); position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%;"/>
        <ui:VisualElement name="Container" enabled="true" style="flex-grow: 1; justify-content: center; width: 100%; margin-bottom: 0; align-self: center; align-content: center; height: 100%; padding-top: 100px; padding-right: 100px; padding-bottom: 100px; padding-left: 100px; flex-direction: column;">
            <ui:VisualElement name="VisualElement" class="cover" style="height: 380px; width: 388px; align-self: center; justify-content: center; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; align-items: center; background-image: url(&quot;project://database/Assets/scifi_ui%20white/PNG/Full%20screen%20border/Blue/1x/Asset%201.png?fileID=2800000&amp;guid=f0042641341f3284891f9bdf52a7b975&amp;type=3#Asset 1&quot;); -unity-slice-scale: 1px;">
                <ui:Button text="Continue" name="ContinueBtn" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0;"/>
                <ui:Button text="Save Game" name="SaveGameBtn" class="button" style="margin-right: 0; margin-bottom: 10px;"/>
                <ui:Button text="Load Game" name="LoadGameBtn" class="button" style="margin-right: 0; margin-bottom: 10px;"/>
                <ui:Button text="Settings" name="SettingsBtn" class="button" style="margin-right: 0; margin-bottom: 10px;"/>
                <ui:Button text="Quit" name="QuitBtn" class="button" style="margin-right: 0; margin-bottom: 0;"/>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="background-color: rgb(0, 0, 0); height: 234px; width: 388px; align-self: center; justify-content: center; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; align-items: center; margin-top: 20px;">
                <ui:Label text="Save Ship = F5 " style="color: rgb(255, 255, 255); font-size: 21px; height: 42px; width: 327px; -unity-font-definition: url(&quot;project://database/Assets/Plugins/QFSW/Quantum%20Console/Source/Fonts/OfficeCodePro-Medium.ttf?fileID=12800000&amp;guid=e7f9c7e4780a90b45b581308e8a2f94a&amp;type=3#OfficeCodePro-Medium&quot;); white-space: normal; -unity-text-generator: standard;"/>
                <ui:Label text="Leave Ship Editor = TAB" style="color: rgb(255, 255, 255); font-size: 21px; height: 43px; width: 327px; -unity-font-definition: url(&quot;project://database/Assets/Plugins/QFSW/Quantum%20Console/Source/Fonts/OfficeCodePro-Medium.ttf?fileID=12800000&amp;guid=e7f9c7e4780a90b45b581308e8a2f94a&amp;type=3#OfficeCodePro-Medium&quot;); white-space: normal; -unity-text-generator: standard;"/>
                <ui:Label text="Inventory = I" style="color: rgb(255, 255, 255); font-size: 21px; height: 43px; width: 327px; -unity-font-definition: url(&quot;project://database/Assets/Plugins/QFSW/Quantum%20Console/Source/Fonts/OfficeCodePro-Medium.ttf?fileID=12800000&amp;guid=e7f9c7e4780a90b45b581308e8a2f94a&amp;type=3#OfficeCodePro-Medium&quot;); white-space: normal; -unity-text-generator: standard;"/>
                <ui:Label text="View Fleet = F" style="color: rgb(255, 255, 255); font-size: 21px; height: 43px; width: 327px; -unity-font-definition: url(&quot;project://database/Assets/Plugins/QFSW/Quantum%20Console/Source/Fonts/OfficeCodePro-Medium.ttf?fileID=12800000&amp;guid=e7f9c7e4780a90b45b581308e8a2f94a&amp;type=3#OfficeCodePro-Medium&quot;); white-space: normal; -unity-text-generator: standard;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LoadGameContainer" class="intel-theme-panel ui-hidden" style="width: 600px; height: 500px; padding: 20px; border-radius: 10px; position: absolute; align-self: center;">
            <ui:Label text="LOAD GAME" style="font-size: 24px; -unity-font-style: bold; color: white; margin-bottom: 20px; -unity-text-align: middle-center;"/>
            <ui:ScrollView name="save_list" style="flex-grow: 1; margin-bottom: 20px; background-color: rgba(0, 0, 0, 0.3);"/>
            <ui:Button name="back_btn" text="Back" class="button" style="height: 40px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
