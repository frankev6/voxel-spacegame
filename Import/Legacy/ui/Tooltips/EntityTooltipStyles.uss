.entity-tooltip {
    position: absolute;
    background-color: rgba(8, 12, 28, 0.96);
    border-width: 1px;
    border-color: rgba(100, 150, 255, 0.4);
    border-top-width: 2px;
    padding: 10px 12px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    max-width: 280px;
    min-width: 140px;
    visibility: hidden;
    opacity: 0;
    transition-duration: 0.12s;
    transition-property: opacity;
}

.entity-tooltip.entity-tooltip-visible {
    visibility: visible;
    opacity: 1;
}

.entity-tooltip__name {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: white;
    white-space: normal;
}

.entity-tooltip__description {
    font-size: 13px;
    -unity-font-style: italic;
    color: rgba(200, 210, 230, 0.85);
    margin-bottom: 6px;
    white-space: normal;
}

.entity-tooltip__separator {
    height: 1px;
    background-color: rgba(100, 150, 255, 0.2);
    margin-top: 4px;
    margin-bottom: 6px;
}

.entity-tooltip__info {
    font-size: 12px;
    color: rgba(170, 190, 220, 0.75);
    white-space: normal;
}
