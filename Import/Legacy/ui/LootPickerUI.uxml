    <engine:VisualElement class="intel-theme-screen" style="flex-grow: 1; background-image: none; background-repeat: repeat repeat; -unity-background-scale-mode: scale-to-fit; background-position-x: left 0; background-position-y: top 0; background-size: 100px 100px;">
        <engine:VisualElement name="topContainer" style="flex-grow: 1; align-self: auto; align-items: center; align-content: flex-start; justify-content: center; height: 20%; flex-direction: row;">
            <engine:Label text="Salvage Complete" style="color: rgb(255, 255, 255); font-size: 49px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Plugins/QFSW/Quantum%20Console/Source/Fonts/OfficeCodePro-Medium.ttf?fileID=12800000&amp;guid=e7f9c7e4780a90b45b581308e8a2f94a&amp;type=3#OfficeCodePro-Medium&quot;);"/>
        </engine:VisualElement>
        <engine:VisualElement name="centerContainer" style="height: 80%; width: 100%; padding-right: 26px; padding-left: 26px; flex-grow: 1; overflow: hidden; padding-top: 26px; padding-bottom: 26px; align-self: center;">
