.root-container {
    flex-grow: 1;
    flex-direction: row;
    padding: 20px;
}

.left-panel {
    width: 35%;
    border-right-width: 2px;
    border-color: rgb(50, 60, 80);
    padding: 10px;
}

.right-panel {
    flex-grow: 1;
    padding: 20px;
}

.header-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-color: rgba(100, 150, 255, 0.5);
}

.ship-list-scroll {
    flex-grow: 1;
}

.ship-list-item {
    flex-direction: row;
    height: 80px;
    background-color: rgba(40, 50, 70, 0.6);
    margin-bottom: 8px;
    border-radius: 5px;
    align-items: center;
    padding: 5px;
    transition-duration: 0.1s;
}

.ship-list-item:hover {
    background-color: rgba(60, 70, 100, 0.8);
}

.ship-list-item.selected {
    background-color: rgba(80, 100, 150, 0.9);
    border-width: 1px;
    border-color: rgb(0, 200, 255);
}

.list-item-thumb {
    width: 70px;
    height: 70px;
    background-color: black;
    margin-right: 10px;
    border-radius: 4px;
}

.list-item-content {
    flex-grow: 1;
    justify-content: center;
}

.list-item-name {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}

.list-item-status {
    font-size: 12px;
    color: rgba(200, 200, 200, 0.8);
}

.status-damaged {
    color: rgb(255, 80, 80);
}

.status-intact {
    color: rgb(100, 255, 100);
}

.details-header {
    flex-direction: row;
    margin-bottom: 20px;
}

.details-thumb-large {
    width: 150px;
    height: 150px;
    background-color: black;
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.5);
    margin-right: 20px;
}

.details-info {
    flex-grow: 1;
}

.details-name {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.stat-item {
    width: 48%;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 5px;
    border-radius: 3px;
    margin-right: 2%;
}

.stat-label {
    color: rgb(180, 180, 180);
}

.abilities-list {
    margin-top: 20px;
    margin-bottom: 20px;
    min-height: 50px;
}

.abilities-label {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.ability-tag {
    background-color: rgba(50, 100, 150, 0.5);
    padding: 4px 8px;
    border-radius: 4px;
    margin-right: 5px;
    color: white;
    font-size: 12px;
}

.actions-bar {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 20px;
    border-top-width: 1px;
    border-color: rgba(100, 150, 255, 0.3);
}

.btn-action {
    height: 40px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(0, 100, 200, 0.8);
    border-width: 0;
    border-radius: 4px;
    color: white;
    font-size: 16px;
    margin-left: 10px;
    transition-duration: 0.1s;
}

.btn-action:hover {
    background-color: rgb(0, 120, 240);
    scale: 1.05;
}

.btn-action:active {
    background-color: rgb(0, 80, 160);
    scale: 0.95;
}

.btn-repair {
    background-color: rgba(50, 150, 50, 0.8);
}

.btn-repair:hover {
    background-color: rgb(60, 180, 60);
}

.btn-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 30px;
    height: 30px;
    background-color: rgba(200, 50, 50, 0.8);
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
    border-radius: 15px;
}

.ability-icon-large {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(100, 150, 255, 0.3);
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 4px;
    transition-duration: 0.1s;
}

.ability-icon-large:hover {
    border-color: rgb(0, 200, 255);
    scale: 1.1;
}

.health-bar-container {
    height: 15px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(100, 150, 255, 0.3);
    border-radius: 3px;
    margin-top: 4px;
    overflow: hidden;
    position: relative;
    width: 100%;
}

.health-bar-fill {
    height: 100%;
    background-color: rgb(0, 120, 255);
    width: 100%;
}

.health-bar-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
}

.details-health-container {
    height: 24px;
    margin-top: 10px;
    margin-bottom: 15px;
}

.details-health-text {
    font-size: 14px;
}

.fleet-thumb-fallback {
    background-color: rgb(90, 90, 90);
}
