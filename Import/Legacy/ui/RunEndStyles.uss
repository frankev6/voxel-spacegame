.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.full-screen {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
}

.flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
}

.run-end-container {
    width: 60%;
    max-width: 900px;
    min-width: 600px;
    padding: 60px;
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(10, 15, 25, 0.95);
    box-shadow: 0 0 50px rgba(0, 0, 0, 0.5);
}

.glass-sub-panel {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-vertical: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.run-end-container .stat-value {
    font-size: 18px;
}

.fleet-scroll {
    flex-grow: 1;
    margin-top: 10px;
}

.meta-footer {
    background-color: rgba(0, 255, 200, 0.05);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 255, 200, 0.2);
}

.blueprint-icon-large {
    width: 64px;
    height: 64px;
}

.text-vibrant {
    color: #00ffc8;
    text-shadow: 0 0 10px rgba(0, 255, 200, 0.5);
}

.text-victory {
    color: #00ffc8;
}

.text-defeat {
    color: #ff4444;
}

.fleet-item {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    margin-bottom: 5px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
}

.fleet-item-icon {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-right: 15px;
}

.fleet-item-name {
    color: #ffffff;
    font-size: 16px;
}

.fleet-item-icon-fallback {
    background-color: rgba(255, 255, 255, 0.1);
}
