            "questId": "quest_ark_material_turnin",
            "value": "Active"
          },
          "outcomes": [
            {
              "type": "RemoveItem",
              "parameter1": "500",
              "parameter2": "3"
            },
            {
              "type": "CustomAction",
              "parameter1": "state.set",
              "parameter2": "key=quest.ark_material_turnin.turnedin|value=1"
            },
            {
              "type": "CustomAction",
              "parameter1": "quest.complete_objective",
              "parameter2": "questId=quest_ark_material_turnin|objectiveId=deliver_to_ark"
