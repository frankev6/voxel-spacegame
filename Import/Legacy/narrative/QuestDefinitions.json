          "objectiveType": "collect_item",
          "targetId": "500",
          "targetCount": 3
        },
        {
          "id": "deliver_to_ark",
          "title": "Deliver Materials",
          "description": "Turn in the materials at ARK station.",
          "objectiveType": "custom_condition",
