/* Implements SPEC-80 §4.4 (ART-002). PULP HORIZON direction sheet: every binding token (DESIGN-SYSTEM §10.1) with the
   PULP HORIZON column of §8.1, plus every proposed token of §11. Review material until ART-013; fonts are look-test
   fonts (ART-008). Generated from DESIGN-SYSTEM.md; check with tools/art/check_tokens.py --verify-doc. */
:root {
    /* colours */
    --color-bg: #0F1626;
    --color-surface-1: #18223A;
    --color-surface-2: #22304E;
    --color-surface-3: #2E3F63;
    --color-border: #5B6E96;
    --color-text: #F6EEDC;
    --color-text-muted: #C7C0AE;
    --color-accent: #FFC233;
    --color-accent-strong: #FFE08A;
    --color-positive: #A3DE52;
    --color-warning: #FF9F1C;
    --color-danger: #FF7085;
    --color-info: #62CCFF;
    --color-ally: #4FA3FF;
    --color-enemy: #FF6B35;
    --color-neutral: #E9DFC7;
    --color-shield: #4FD1FF;
    --color-hull: #F6EEDC;
    --color-energy: #FFB020;
    --color-border-strong: #8C9DC4;
    --color-text-on-accent: #0F1626;
    --color-overlay: rgba(8, 12, 22, 0.60);
    --color-objective: #FFE08A;
    --color-clue: #FF7FC8;
    /* factions (functional: SPEC-33/61) */
    --color-faction-ark: #3FA7FF;
    --color-faction-raiders: #FF4F3A;
    --color-faction-xeno: #C266FF;
    --color-faction-vestari: #2FD6A8;
    --color-faction-tlaxcala: #FF9F1C;
    --color-faction-khuchad-clan: #E8D23A;
    --color-faction-neutral: #D0D6E2;
    /* travel (functional: SPEC-32 §5.8) */
    --color-travel-cover: #FFB84D;
    --duration-travel-fade: 0.5s;
    /* space, shape, icons, HUD */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 64px;
    --radius-s: 4px;
    --radius-m: 8px;
    --radius-l: 14px;
    --border-thin: 2px;
    --border-thick: 3px;
    --icon-s: 16px;
    --icon-m: 24px;
    --icon-l: 32px;
    --hud-margin: 32px;
    /* type */
    --font-display: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_ArchivoExpanded-ExtraBold_SDF.asset");
    --font-body: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_AtkinsonHyperlegible-Regular_SDF.asset");
    --font-mono: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_SpaceMono-Regular_SDF.asset");
    --text-xs: 13px;
    --text-s: 15px;
    --text-m: 17px;
    --text-l: 22px;
    --text-xl: 30px;
    --text-xxl: 44px;
    --font-body-strong: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_AtkinsonHyperlegible-Bold_SDF.asset");
    /* motion and opacity */
    --duration-fast: 100ms;
    --duration-normal: 200ms;
    --duration-slow: 350ms;
    --easing-in: ease-out-back;
    --easing-out: ease-in-cubic;
    --opacity-disabled: 0.4;
    --opacity-hud-panel: 0.90;
}
