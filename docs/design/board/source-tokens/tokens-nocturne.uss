/* Implements SPEC-80 §4.4 (ART-002). NOCTURNE direction sheet: every binding token (DESIGN-SYSTEM §10.1) with the
   NOCTURNE column of §8.1, plus every proposed token of §11. Review material until ART-013; fonts are look-test
   fonts (ART-008). Generated from DESIGN-SYSTEM.md; check with tools/art/check_tokens.py --verify-doc. */
:root {
    /* colours */
    --color-bg: #05070D;
    --color-surface-1: #0A0F1A;
    --color-surface-2: #101826;
    --color-surface-3: #172233;
    --color-border: #2A3B55;
    --color-text: #DCE8F5;
    --color-text-muted: #8FA6C2;
    --color-accent: #39D5FF;
    --color-accent-strong: #A6EEFF;
    --color-positive: #3DD6A3;
    --color-warning: #FFC247;
    --color-danger: #FF5C7A;
    --color-info: #8FB0FF;
    --color-ally: #5B8CFF;
    --color-enemy: #FF7A45;
    --color-neutral: #B9C3D1;
    --color-shield: #3FD8FF;
    --color-hull: #EDE6DA;
    --color-energy: #FFB84D;
    --color-border-strong: #56769F;
    --color-text-on-accent: #05070D;
    --color-overlay: rgba(2, 4, 10, 0.70);
    --color-objective: #FFE08A;
    --color-clue: #E0C3FF;
    /* factions (functional: SPEC-33/61) */
    --color-faction-ark: #7FB2FF;
    --color-faction-raiders: #FF5A66;
    --color-faction-xeno: #B48CFF;
    --color-faction-vestari: #5CE0C0;
    --color-faction-tlaxcala: #FFB866;
    --color-faction-khuchad-clan: #E6E07A;
    --color-faction-neutral: #A9B4C8;
    /* travel (functional: SPEC-32 §5.8) */
    --color-travel-cover: #000000;
    --duration-travel-fade: 0.5s;
    /* space, shape, icons, HUD */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 64px;
    --radius-s: 0px;
    --radius-m: 0px;
    --radius-l: 2px;
    --border-thin: 1px;
    --border-thick: 2px;
    --icon-s: 16px;
    --icon-m: 24px;
    --icon-l: 32px;
    --hud-margin: 32px;
    /* type */
    --font-display: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_Michroma-Regular_SDF.asset");
    --font-body: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_Inter-Regular_SDF.asset");
    --font-mono: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_JetBrainsMono-Regular_SDF.asset");
    --text-xs: 12px;
    --text-s: 14px;
    --text-m: 16px;
    --text-l: 20px;
    --text-xl: 26px;
    --text-xxl: 34px;
    --font-body-strong: url("project://database/Assets/Game/Art/LookTest/Fonts/FNT_Inter-SemiBold_SDF.asset");
    /* motion and opacity */
    --duration-fast: 120ms;
    --duration-normal: 250ms;
    --duration-slow: 500ms;
    --easing-in: ease-in-out-sine;
    --easing-out: ease-in-out-sine;
    --opacity-disabled: 0.4;
    --opacity-hud-panel: 0.80;
}
